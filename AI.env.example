# Copy to AI.env and fill your keys.
# Then export variables before running API (or source the file).

LLM_SUMMARY_PROVIDER=openrouter
LLM_SUMMARY_MODEL=google/gemini-2.0-flash-exp:free
LLM_SUMMARY_API_KEY=YOUR_OPENROUTER_KEY

LLM_MOVE_PROVIDER=groq
LLM_MOVE_MODEL=llama-3.1-8b-instant
LLM_MOVE_API_KEY=YOUR_GROQ_KEY

LLM_CHAT_PROVIDER=groq
LLM_CHAT_MODEL=llama-3.1-8b-instant
LLM_CHAT_API_KEY=YOUR_GROQ_KEY

# Optional local fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
