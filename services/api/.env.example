# Backend server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage
DATA_DIR=data
DATABASE_PATH=data/chess_tutor.sqlite3

# Chess engine
STOCKFISH_PATH=C:\path\to\stockfish.exe

# LLM routing (cloud + optional local fallback)
# Providers: openrouter | groq | gemini | ollama | deterministic
# Recommended architecture:
# - Summary model = strongest model you can access
# - Move model = faster/cheaper model
# - Chat model = low-latency chat model
# If a provider/model/key is missing, service falls back to deterministic grounded text.
OLLAMA_BASE_URL=http://127.0.0.1:11434

LLM_SUMMARY_PROVIDER=openrouter
LLM_SUMMARY_MODEL=google/gemini-2.0-flash-exp:free
LLM_SUMMARY_API_KEY=

LLM_MOVE_PROVIDER=groq
LLM_MOVE_MODEL=llama-3.1-8b-instant
LLM_MOVE_API_KEY=

LLM_CHAT_PROVIDER=groq
LLM_CHAT_MODEL=llama-3.1-8b-instant
LLM_CHAT_API_KEY=
