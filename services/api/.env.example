# Backend server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage
DATA_DIR=data
DATABASE_PATH=data/chess_tutor.sqlite3

# Chess engine
STOCKFISH_PATH=C:\path\to\stockfish.exe

# Optional local LLM
# Leave these unset to use deterministic explanations only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
